CREATE TABLE limit_rule_record (
    id TEXT NOT NULL PRIMARY KEY,
    app_ids_json TEXT NOT NULL,
    kind TEXT NOT NULL,
    params_json TEXT NOT NULL,
    schedule_json TEXT,
    strictness TEXT NOT NULL,
    enabled INTEGER NOT NULL DEFAULT 1
);

selectAllRules:
SELECT * FROM limit_rule_record;

selectRuleById:
SELECT * FROM limit_rule_record
WHERE id = :id;

insertOrReplaceRule:
INSERT OR REPLACE INTO limit_rule_record(id, app_ids_json, kind, params_json, schedule_json, strictness, enabled)
VALUES (:id, :appIdsJson, :kind, :paramsJson, :scheduleJson, :strictness, :enabled);

deleteRuleById:
DELETE FROM limit_rule_record
WHERE id = :id;
