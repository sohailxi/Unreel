# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files you want to always have LF
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.swift text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.gradle text eol=lf
*.xcconfig text eol=lf
*.pbxproj text eol=lf

# Windows scripts must have CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.jar binary
*.keystore binary
*.jks binary
